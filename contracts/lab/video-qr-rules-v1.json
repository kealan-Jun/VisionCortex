{
  "schema_version": "vc-lab-video-qr-rules/1",
  "enabled_by_default": false,
  "execution": {
    "model_required": false,
    "explicit_source_registration_required": true,
    "source_sha256_and_version_required": true,
    "original_pts_required": true,
    "all_decoded_frames_in_registered_interval": true,
    "permitted_rotation_degrees_clockwise": [
      0,
      180
    ],
    "frame_sampling": false,
    "max_registered_intervals": 16,
    "max_registered_source_seconds": 10,
    "max_task_frames": 600,
    "max_task_wall_seconds": 120,
    "max_buffer_bytes": 67108864,
    "explicit_private_decoder_environment_required": true,
    "source_sha_verified_before_and_after": true
  },
  "isolation": [
    "customer_id",
    "media_id",
    "source_stream_key",
    "source_session_key",
    "original_pts"
  ],
  "trust": {
    "decoded_text_is_untrusted_evidence": true,
    "decoded_qr_is_not_panel_identity": true,
    "decoded_qr_is_not_operation_focus": true,
    "no_decode_does_not_prove_no_visible_qr": true,
    "no_ocr_fields_created": true,
    "no_confirmed_facts_or_material_ledger_writes": true,
    "unknown_world_clock_remains_uncalibrated": true,
    "small_window_is_not_whole_media_coverage": true
  },
  "integration": {
    "existing_task_lease_checkpoint_trace_and_report": true,
    "production_source_activation": false,
    "original_components_changed": false
  }
}
