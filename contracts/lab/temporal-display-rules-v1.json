{
  "schema_version": "vc-lab-temporal-display-rules/1",
  "enabled_by_default": false,
  "input": {
    "registration_required": true,
    "original_decoded_pts_required": true,
    "nominal_capture_fps_is_not_a_timestamp": true,
    "source_pixels_and_orientation_transform_recorded": true,
    "permitted_explicit_rotation_degrees_clockwise": [
      0,
      180
    ],
    "original_media_mutation": false
  },
  "isolation_keys": [
    "device_id",
    "screen_id",
    "field_id",
    "track_session_id"
  ],
  "window_frame_candidates": [
    3,
    5,
    8,
    15,
    30
  ],
  "max_window_span_seconds": 1,
  "roi_cache_bytes": 67108864,
  "roi_cache_retention_seconds": 86400,
  "task_output_limit_bytes": 134217728,
  "trust": {
    "statuses": [
      "confirmed",
      "uncertain",
      "unreadable"
    ],
    "confirmed_meaning": "visual evidence gates only, never a business confirmation",
    "segment_states": [
      "ON",
      "OFF",
      "UNKNOWN"
    ],
    "dark_is_not_automatically_off": true,
    "local_observation_opportunity_required_for_off": true,
    "unknown_strokes_not_inferred_from_legal_templates": true,
    "same_text_alone_is_not_confirmation": true,
    "content_state_ambiguity_stops_fusion": true,
    "unsupported_decimal_sign_unit_not_inserted": true,
    "historical_value_not_a_current_reading": true,
    "unmeasured_quality_is_not_calibrated_probability": true
  },
  "reset_on": [
    "source_or_identity_switch",
    "track_loss",
    "registration_failure",
    "scene_change",
    "pts_gap_or_disorder"
  ],
  "original_components_changed": false,
  "customer_source_activation": false,
  "production_service_switch": false,
  "source_frame_numeric": {
    "enabled_by_default": false,
    "explicit_field_option": "layout.numeric_anchor",
    "method": "vc-video-numeric-anchor/3",
    "requires_versioned_digit_slot_layout": true,
    "pixels_from_one_original_frame": true,
    "max_window_frames": 30,
    "max_window_seconds": 1,
    "source_aware_OCR_receipts": true,
    "candidate_only": true,
    "confirmed": false,
    "automatic_physical_identity": false,
    "shorter_tokens_are_vetoed_not_replaced": true,
    "clock_separators_preserved": true,
    "real_quality_acceptance": "NOT_PROVEN",
    "glyph_adapter": {
      "enabled_by_default": false,
      "method": "vc-native-glyph-prototypes/1",
      "single_glyph_labels_only": true,
      "max_prototypes": 12,
      "max_shared_translation_pixels": 2,
      "minimum_similarity": 0.85,
      "minimum_class_margin": 0.12,
      "unknown_glyphs_preserved": true,
      "decimal_requires_same_source_pixel_evidence": true,
      "neural_training_required": false,
      "independent_quality": "NOT_PROVEN"
    },
    "strict_decimal_evidence": {
      "enabled_by_default": false,
      "method": "native_interglyph_core_island/1",
      "source_pixels_only": true,
      "exclude_glyph_strokes": true,
      "model_only_decimal_is_not_evidence": true
    },
    "native_original_pixels": {
      "enabled_by_default": false,
      "method": "native_registered_crop/1",
      "input": "registered_red_or_green_LED_field",
      "unresampled_OCR": true,
      "absence_veto": {
        "minimum_chroma95": 20,
        "minimum_positive_area_fraction": 0.02,
        "minimum_native_digit_height": 12
      },
      "expected_readings": false,
      "character_templates": false,
      "physical_identity_inferred": false,
      "requires_registered_field_geometry": true,
      "full_glyph_quality": "NOT_PROVEN",
      "early_candidate_frames": 3,
      "maximum_recognition_frequency_hz": 1,
      "call_budget_survives_pixel_tracking_resets": true
    },
    "engineering_replay": {
      "entry": "tools/evaluation/replay_display_ocr.py",
      "runner": "TemporalVideo.run",
      "template_corrections_prohibited": true,
      "default_mode": "exact_input_receipt_replay",
      "business_writes": false
    }
  }
}
