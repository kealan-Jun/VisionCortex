[Unit]
Description=VisionCortex HTTP interface
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/visioncortex/runtime.env
Environment=VISIONCORTEX_RUNTIME_ROLE=web
ExecStart=/bin/sh -c 'exec /usr/bin/python3 "$VISIONCORTEX_DEPLOY_TOOLS/Launch.py" web'
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=90
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
