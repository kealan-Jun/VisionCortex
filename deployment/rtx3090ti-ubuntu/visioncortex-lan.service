[Unit]
Description=VisionCortex authenticated LAN production server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
@ENVIRONMENT@
ExecStartPre=/usr/bin/bash @PREFLIGHT@ --production
ExecStart=/usr/bin/bash @RUNNER@
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
