# Copy outside Git. Fill every private binding before explicitly starting a service.
VC_LAB_DATABASE_URL=postgresql://ROLE@localhost/DATABASE
VC_LAB_CUSTOMER_CODE=example
VC_LAB_RUNTIME_ROOT=.runtime/lab
VC_LAB_API_TOKEN=
VC_LAB_ALLOW_EXTERNAL_INFERENCE=0
VC_LAB_PHOTO_BATCH_MODE=receipt_only
VC_LAB_PHOTO_CAMERAS=[]
VC_LAB_PROCESSING_PROFILE=native
VC_LAB_TIMELINE_PUBLISH=0
# Optional explicit private files; no source, NAS or model is enabled by default.
# VC_LAB_MODEL_MANIFEST=
# VC_LAB_SOURCE_ROOT=
# VC_LAB_STORAGE_MANIFEST=
# VC_LAB_NAS_MARKER_SHA256=
# VC_LAB_LIVE_SOURCES_MANIFEST=
# VC_LAB_TIMELINE_POLICY=
# VC_LAB_TIMELINE_PROVIDERS=
# VC_LAB_UNIFIED_ARCHIVE_REQUIRED=1
# VC_LAB_DECODER_PYTHON=
