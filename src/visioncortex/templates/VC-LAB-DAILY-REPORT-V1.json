{
  "template_id": "VC-LAB-DAILY-REPORT-V1",
  "schema_version": "1.0.0",
  "title": "VisionCortex 实验室日报",
  "page": {
    "size": "A4-landscape",
    "margin_mm": 12,
    "font_family": "Microsoft YaHei",
    "footer": ["template_id", "experiment_id", "page_number"]
  },
  "sections": [
    {
      "id": "daily_overview",
      "title": "当日总览",
      "required": true,
      "fields": ["report_date", "experiment_id", "input_view_count", "experiment_group_count", "key_event_count", "physical_change_count", "total_duration_seconds", "total_tokens"]
    },
    {
      "id": "experiment_matrix",
      "title": "全天实验矩阵",
      "required": true,
      "columns": ["experiment_name", "start_timecode", "end_timecode", "continuity_type", "duration_seconds", "step_count", "key_event_count", "physical_change_count", "participating_view_count"]
    },
    {
      "id": "alignment_audit",
      "title": "跨视角对齐审计",
      "required": true,
      "columns": ["view_id", "role", "state", "confidence", "csv_match_count", "csv_match_ratio", "csv_rmse_ms", "visual_correction_ms", "visual_confidence"]
    },
    {
      "id": "experiment_evidence",
      "title": "逐实验步骤与证据",
      "required": true,
      "repeat_for": "experiment_timeline",
      "subsections": ["experiment_summary", "step_table", "physical_change_summary", "key_event_evidence_index"]
    },
    {
      "id": "action_summary",
      "title": "六类关键动作统计",
      "required": true
    },
    {
      "id": "quality_and_uncertainty",
      "title": "质量、不确定性与矛盾",
      "required": true
    },
    {
      "id": "performance_and_tokens",
      "title": "阶段耗时与阶段 Token",
      "required": true,
      "columns": ["stage", "duration_seconds", "input_tokens", "output_tokens", "total_tokens", "call_count"]
    },
    {
      "id": "human_review",
      "title": "自动验收与可选备注",
      "required": false,
      "completion_gate": "evidence_package_eval",
      "fields": ["status", "reviewer_id", "reviewed_at", "comments"]
    }
  ],
  "claim_policy": {
    "observed_fact": "CV、时间轴或多视角视频可直接回溯的观察事实",
    "supported_model_understanding": "由已归档关键帧或关键片段支持的模型理解",
    "uncertain": "证据不足、遮挡或跨视角不一致，必须显式标记",
    "forbid_unreferenced_claims": true
  },
  "generation_policy": {
    "layout_editable_by_model": false,
    "content_source": "accepted_evidence_package_only",
    "additional_mllm_calls": false,
    "additional_model_tokens": 0
  }
}
