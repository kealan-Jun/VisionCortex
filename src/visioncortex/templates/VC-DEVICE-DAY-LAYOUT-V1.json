{
  "schema_version": "visioncortex-frozen-archive-layout/1",
  "authorized_date": "2026-10-19",
  "changes_require": "explicit_human_user_instruction",
  "device_day": "<date>_<device>_<camera>",
  "directories": ["MetaData", "ProcessedClips", "MultimodalUnderstanding", "LaboratoryDailyReport", "Comment"],
  "historical_raw_directory": "MetaVideo",
  "preserve_recorder_native_paths_and_bytes": true,
  "clip_container": "ProcessedClips/Clips",
  "clip_name": "<start>_<end>_<activity>_<short-id>",
  "activities": {"active": "ExperimentActivity", "inactive": "NoExperimentActivity"},
  "understanding_container": "MultimodalUnderstanding",
  "understanding_uses_same_clip_name": true,
  "understanding_files": ["Understanding.json"],
  "transcript_files": ["Transcript.json", "Transcript.txt"],
  "report_files": ["LaboratoryDailyReport.html", "LaboratoryDailyReport.json"],
  "private_evidence_directory": ".Evidence",
  "visible_hash_directory_chains": false,
  "retain_valuable_experiment_video": true,
  "retain_valuable_non_experiment_video": true,
  "inactive_label_is_discard_decision": false,
  "preserve_omitted_intervals_and_reasons": true,
  "inactive_key_frames": [],
  "action_frame_path": "KeyFrames/<action>/<video-time>.jpg",
  "scene_frame_kind": "scene_sample"
}
