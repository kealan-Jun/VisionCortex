{
  "template_id": "VC-LAB-DAILY-REPORT-V2",
  "schema_version": "2.0.0",
  "title": "VisionCortex 实验室日报",
  "audience": "当班实验人员、实验室负责人和项目成员",
  "reading_goal": "三分钟内理解当日发生了什么、结果是否可信、需要关注什么以及证据在哪里",
  "page": {
    "primary_format": "responsive-html",
    "print_size": "A4-portrait",
    "theme": "VisionCortex",
    "logo_required": true
  },
  "sections": [
    {
      "id": "daily_overview",
      "title": "今日概览",
      "required": true,
      "fields": ["report_date", "experiment_group_count", "key_event_count", "physical_change_count", "quality_status", "total_duration_seconds", "total_tokens"]
    },
    {
      "id": "experiment_briefs",
      "title": "实验简报",
      "required": true,
      "repeat_for": "experiment_timeline",
      "fields": ["experiment_name", "bounded_time", "continuity_type", "overall_summary", "representative_visual", "current_and_next_steps", "action_counts"]
    },
    {
      "id": "attention_and_handoff",
      "title": "关注事项与交接",
      "required": true,
      "fields": ["quality_status", "uncertainties", "contradictions", "low_recall_warnings", "archive_links"]
    },
    {
      "id": "cost_and_timing",
      "title": "耗时与模型用量",
      "required": true,
      "fields": ["total_duration_seconds", "preprocessing_seconds", "input_tokens", "output_tokens", "total_tokens"]
    },
    {
      "id": "human_review",
      "title": "自动验收与可选备注",
      "required": false,
      "completion_gate": "evidence_package_eval"
    }
  ],
  "visual_policy": {
    "source": "accepted_key_materials_only",
    "dual_view_only": true,
    "daily_images_per_experiment": 1,
    "show_event_id_and_timestamp": true,
    "missing_image_behavior": "show_explicit_placeholder"
  },
  "writing_policy": {
    "tone": "professional_plain_language",
    "lead_with_outcome": true,
    "avoid_unexplained_engineering_terms": true,
    "separate_observation_from_model_understanding": true
  },
  "generation_policy": {
    "layout_editable_by_model": false,
    "content_source": "accepted_evidence_package_only",
    "report_narrative_source": "accepted_existing_model_understanding",
    "additional_mllm_calls": false,
    "additional_model_tokens": 0
  }
}
